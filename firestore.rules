rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check for admin privileges.
    function isAdmin() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Only admins can read or write the list of admins.
    match /admins/{userId} {
      allow get: if request.auth.uid == userId || isAdmin();
      allow list, create, update, delete: if isAdmin();
    }

    // Users can manage their own profile. Admins can manage any user profile.
    match /users/{userId} {
      allow get: if request.auth.uid == userId || isAdmin();
      allow list: if isAdmin();
      allow create: if request.auth.uid == userId;
      allow update, delete: if request.auth.uid == userId || isAdmin();
    }

    // Public content is readable by anyone.
    // Write access is restricted to admins.
    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /resources/{resourceId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /podcasts/{podcastId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /webinars/{webinarId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /blog_categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Rule for the nested podcasts collection
    match /artifacts/{appId}/public/data/podcasts/{podcastId} {
      // Allow anyone to read approved podcasts, and admins to read all
      allow read: if resource.data.approved == true || isAdmin();

      // Allow authenticated users to create new podcasts, but only if they are not approved
      allow create: if request.auth != null && request.resource.data.approved == false;

      // Allow admins to update (approve) and delete podcasts
      allow update, delete: if isAdmin();
    }

    // Drafts can be created, updated, and deleted by their author.
    // Admins can also read drafts (e.g., for review).
    match /drafts/{draftId} {
      allow read: if isAdmin() || resource.data.authorId == request.auth.uid;
      allow create, update, delete: if request.resource.data.authorId == request.auth.uid;
    }

    // Submissions can be created by the author.
    // Admins can read and delete submissions.
    match /submissions/{submissionId} {
      allow create: if request.resource.data.authorId == request.auth.uid;
      allow read, delete: if isAdmin();
    }

    // Logs can only be created by admins and cannot be read or modified by anyone.
    match /logs/{logId} {
      allow create: if isAdmin();
      allow read, update, delete: if false;
    }
  }
}